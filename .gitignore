node_modules/
.env
.env.local
# Catch editor-mangled copies too: Notepad silently saves ".env.local" as
# ".env.local.txt", which the bare rule above misses and git would happily
# commit with the service_role key inside it.
.env*
!.env.example
*.log
.expo/
dist/
__pycache__/
scripts/.cache/
# Eval run outputs: per-run JSON, regenerated by run.py and never reviewed in
# a diff. The numbers that matter live in evals/HARD_MEALS.md and BUILD_LOG.md.
evals/*_results.json
evals/hard_*.json
evals/easy_*.json
!evals/hard_source.json
# A/B arm transcripts from ab runs; the numbers go in BUILD_LOG.md
evals/log_*.txt
